    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@gochi/contracts": "*",
    "@hono/node-server": "^2.1.3",
    "@noble/hashes": "^1.8.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/wallet-standard-util": "^1.1.4",
    "@solana/web3.js": "^1.99.0",
    "drizzle-orm": "^0.38.3",
    "hono": "^4.6.14",
    "jose": "^5.9.6",
    "postgres": "^3.4.5",
    "zod": "^3.23.8",
    "@types/node": "^22.10.2",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "~5.9.2",
    "vitest": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "~5.9.2",
    "vitest": "^5.0.3"
  }
