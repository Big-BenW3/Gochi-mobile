{
  "name": "@gochi/api",
  "version": "0.1.0",
  "private": true,
  "description": "Gochi backend. Authoritative for companion state, progression, activity ingestion and notifications.",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
