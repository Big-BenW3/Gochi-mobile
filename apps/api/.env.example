# ============================================================================
# Gochi API — environment
#
# Copy to `.env` next to this file:  cp .env.example .env
#
# `.env` is gitignored. Never commit secrets.
#
# The mobile app has its own environment in `mobile/.env` and the two are
# independent — nothing is shared, so a change here cannot silently alter what
# ships inside the APK.
#
# In production none of this comes from a file: Render injects these as
# environment variables, and `env.ts` skips the file when it is absent.
#
# Why `required()` is a boot-blocker and `optional()` is not:
# a required variable means the API refuses to start without it. Optional just
# means it is read when present. The mint payer is optional for exactly that
# reason — identity, the engine and every read route work without one, and
# minting reports its own failure rather than taking the whole server down.
#
# NEVER give a server secret an EXPO_PUBLIC_ name. Expo inlines those into the
# app bundle, so anyone who unpacks the APK can read them. `env.ts` refuses to
# boot if it finds one.
# ============================================================================

# ---- required: the API will not start without these ----------------------

# Neon, DIRECT connection. Used for migrations, which run DDL and need a pinned
# session. Keep the pooled URL below for the running server.
DATABASE_URL=

# Session signing secret. Generate one with: openssl rand -base64 48
API_JWT_SECRET=

# Privy App ID.
#
# The EXPO_PUBLIC_ prefix is correct even here, and required: this is a public
# identifier that the app already ships in its bundle, and the server uses it as
# the JWT `audience` so a token minted for a different Privy app is rejected.
#
# There is deliberately no Privy app secret. Token verification is asymmetric —
# it checks the signature against Privy's published JWKS — so no secret is
# involved. One would only be needed the moment this server called a Privy REST
# endpoint, and it should be introduced then rather than carried unused on a
# public host.
EXPO_PUBLIC_PRIVY_APP_ID=

# ---- the mint payer ------------------------------------------------------
#
# The Solana keypair that pays for the companion mint (~0.0027 SOL on devnet),
# base64-encoded. Optional as a variable; required in practice if you want
# minting to work.
#
# Why base64 and not a file path: this has to run in two places with opposite
# needs. On a laptop a keyfile on disk is natural and keeps the secret out of
# shell history. On a host there is no such file, and baking one into an image
# would put a funded wallet into git history permanently.
#
# A Solana keyfile is a JSON array of 64 bytes, so this is base64 of that JSON
# *text*, not of the raw bytes — 300 characters, not 88. Generate it with:
#
#     base64 -w0 ~/.config/solana/id.json
#
# The bytes are decoded in memory, never written to disk, never logged.
PAYER_SECRET_KEY_BASE64=

# ---- Solana RPC ----------------------------------------------------------

# The one WRITE: creating the companion asset on devnet. Kept on devnet so the
# demo spends nothing real and mainnet state is never touched.
SOLANA_RPC_URL=https://api.devnet.solana.com

# Every READ: wallet history for ingestion, token balances in the vault, the
# Seeker Genesis Token, and .skr resolution.
#
# Mainnet is not a preference here. The Genesis Token exists only on mainnet and
# .skr names are mainnet ANS records, so reading either from devnet reports every
# wallet as having no device and every name as unresolved — confident wrong
# answers rather than errors, which is the worst kind. A user's real balances and
# transaction history are on mainnet too.
#
# A paid provider is worth it: the public endpoint rate-limits, and it
# intermittently drops getSignaturesForAddress, which would leave the companion
# inert for reasons invisible from the client.
SOLANA_MAINNET_RPC_URL=https://mainnet.helius-rpc.com/?api-key=

# ---- optional ------------------------------------------------------------

# Helius dashboard key. Used for the Helius *webhook* adapter, which is an
# unfinished stub and is deliberately never selected — ingestion reads through
# SOLANA_MAINNET_RPC_URL instead, so configuring this cannot switch the app onto
# a code path that returns nothing.
HELIUS_API_KEY=

# Postgres pool ceiling. The default of 2 suits Neon free tier; raising it
# without raising Neon's own limit is the fastest way to get "too many
# connections".
DB_POOL_MAX=2

# Rate-limit budgets per window. The middleware falls back to 120/30 when unset.
# The test suite sets small values so its flood cases do not need hundreds of
# round trips.
# RATE_LIMIT_READ=120
# RATE_LIMIT_WRITE=30

# Port the server listens on. Platforms that assign one (Render, Fly) set this
# for you; it defaults to 8787 locally.
# PORT=8787