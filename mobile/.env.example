# ============================================================================
# Gochi mobile app — environment
#
# Copy to `.env` next to this file:  cp .env.example .env
#
# `.env` is gitignored. Never commit secrets.
#
# This must live HERE, in `mobile/`, not at the repo root. Expo resolves `.env`
# relative to its own project root, so a file at the root is silently ignored —
# the app then bundles `undefined` for these values and falls back to whatever
# hardcoded default the code happens to carry. That failure looks like a server
# problem, not a configuration one.
#
# Only `EXPO_PUBLIC_` variables reach the device: Expo inlines them into the
# bundle at build time, where anyone unpacking the APK can read them. Never put a
# secret here. The server's environment lives separately in `apps/api/.env`.
# ============================================================================

# Privy App ID. Public by design — this ships in the bundle, so it must match the
# one the API uses as its JWT audience.
EXPO_PUBLIC_PRIVY_APP_ID=

# Privy Client ID, for the native SDK's initialisation. Mobile-only; the server
# never reads it.
EXPO_PUBLIC_PRIVY_CLIENT_ID=

# Base URL of the Gochi API.
#
# Baked into the bundle at build time, so this is fixed when the APK is built —
# changing it requires a rebuild, not just a restart. It must be the deployed
# host, because `localhost` on a handset is the handset itself: leave it at
# localhost only while running against a server on the same machine over Metro.
EXPO_PUBLIC_API_URL=http://localhost:8787