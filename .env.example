# ============================================================================
# Gochi — environment
#
# Copy to `.env` at the repo root:  cp .env.example .env
#
# `.env` is gitignored. Never commit secrets, and never put a server-side
# secret in a variable prefixed EXPO_PUBLIC_ — those are inlined into the app
# bundle and readable by anyone who unpacks the APK.
#
# Mobile app (safe to ship in the bundle):
#   EXPO_PUBLIC_PRIVY_APP_ID        Privy App ID, from the Privy dashboard
#   EXPO_PUBLIC_PRIVY_CLIENT_ID     Privy Client ID, for the Android package id
#   EXPO_PUBLIC_API_URL             Base URL of the Gochi API
#
# API only (server-side, must never reach the client):
#   DATABASE_URL                    Postgres connection string
#   API_JWT_SECRET                  Signing secret for session tokens
#   HELIUS_API_KEY                  Helius dashboard key, for activity ingestion
#   PAYER_KEYPAIR_PATH              Path to the mint payer keypair (server only)
#   SOLANA_RPC_URL                  Solana JSON RPC endpoint
# ============================================================================

# ---- mobile app ----------------------------------------------------------
EXPO_PUBLIC_PRIVY_APP_ID=
EXPO_PUBLIC_PRIVY_CLIENT_ID=
EXPO_PUBLIC_API_URL=http://localhost:8787

# ---- api -----------------------------------------------------------------
DATABASE_URL=
API_JWT_SECRET=
HELIUS_API_KEY=

# Path to the Solana keypair that pays for companion mints. Read by the API only.
# Absolute path, so the process does not depend on its working directory.
PAYER_KEYPAIR_PATH=

# Solana cluster. Start on devnet: this project never touches mainnet state
# until P14, and the payer above is funded on devnet.
SOLANA_RPC_URL=https://api.devnet.solana.com